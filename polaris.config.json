{
  "orchestration": {
    "mode": "auto",
    "auto_finalize": true,
    "notification_format": "terse"
  },
  "execution": {
    "adapter": "paperclip",
    "providers": {
      "devin": {
        "command": "devin",
        "args": [
          "--permission-mode",
          "dangerous",
          "-p",
          "{{worker_prompt}}"
        ]
      },
      "claude": {
        "command": "env",
        "args": [
          "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=0",
          "claude",
          "--print",
          "--permission-mode",
          "bypassPermissions",
          "--allowedTools",
          "Read",
          "Write",
          "Edit",
          "Bash(git *)",
          "--",
          "{{worker_prompt}}"
        ]
      },
      "codex": {
        "command": "codex",
        "args": [
          "{{worker_prompt}}"
        ]
      },
      "gemini": {
        "command": "gemini",
        "args": [
          "--prompt",
          "{{worker_prompt}}"
        ]
      },
      "copilot": {
        "command": "copilot",
        "args": [
          "-p",
          "{{worker_prompt}}",
          "--autopilot",
          "--allow-all-tools"
        ]
      },
      "kiro": {
        "command": "kiro-cli",
        "args": [
          "chat",
          "--no-interactive",
          "--trust-all-tools",
          "--agent",
          "default",
          "--effort",
          "medium",
          "{{worker_prompt}}"
        ]
      },
      "coderabbit": {
        "command": "coderabbit",
        "args": [
          "review",
          "--agent"
        ]
      },
      "custom": {
        "command": "$POLARIS_AGENT",
        "args": [
          "{{worker_prompt}}"
        ]
      }
    },
    "allowCrossAgentFallback": false,
    "providerPolicy": {
      "worker": {
        "providers": [
          "devin",
          "copilot",
          "codex",
          "kiro"
        ],
        "allowNativeSubagent": false
      },
      "orchestrator": {
        "providers": [
          "codex",
          "copilot"
        ],
        "allowNativeSubagent": false
      },
      "analyst": {
        "providers": [
          "claude",
          "codex"
        ],
        "allowNativeSubagent": true
      },
      "librarian": {
        "providers": [
          "codex",
          "devin",
          "copilot",
          "claude"
        ]
      },
      "finalizer": {
        "providers": [
          "copilot"
        ]
      },
      "foreman": {
        "providers": [
          "codex"
        ]
      }
    },
    "paperclip": {
      "baseUrl": "http://127.0.0.1:3100",
      "companyId": "e4e9384a-d4a5-46f2-a444-92f5aa6ebdc6",
      "projectId": "4c48e4c7-605f-4334-a322-5b07d5a7ff9a",
      "assigneeAgentId": "7e7e6e43-505e-4edb-bf6b-7cb54aab261c",
      "tokenEnv": "PAPERCLIP_API_KEY",
      "runIdEnv": "POLARIS_RUN_ID",
      "pollIntervalMs": 2000,
      "timeoutMs": 1200000,
      "roleRegistry": {
        "foreman": [
          "7e7e6e43-505e-4edb-bf6b-7cb54aab261c"
        ],
        "worker": [
          "b3caa4b2-0578-40ee-8042-42bffd6fcb5c",
          "9143ed5c-8356-43b8-9b4d-035cbfcf5793",
          "39f35fc9-5434-4226-83e3-a435809aac81",
          "42c3576f-94ac-427e-b4a8-ced4d1167687"
        ],
        "librarian": [
          "af226c67-3541-45ba-839a-b2fafb4ea75c"
        ],
        "medic": [
          "98f310f0-1062-48a3-b02f-6dae833859fb"
        ],
        "qc": []
      },
      "repoUrl": "https://github.com/Lone-Star-Cajun-Technologies/Polaris-CLO.git",
      "workingDirectory": "/home/hermes/Developer/projects/Polaris-CLO",
      "targetPaths": [],
      "monitorRoles": {
        "monitor": "e2bde541-f664-4ae5-bea0-5a394804cac1"
      }
    }
  },
  "budget": {
    "mode": "fixed-cap",
    "max_children": 6,
    "stop_on_fail": false
  },
  "simplicity": {
    "mode": "full"
  },
  "docs": {
    "ingestBatchSize": 10
  },
  "tracker": {
    "adapter": "linear",
    "linear": {
      "teamId": "Polaris",
      "projectId": "Polaris Core Runtime",
      "enabled": true
    }
  },
  "qc": {
    "enabled": true,
    "defaultTrigger": "completed-cluster",
    "providers": {
      "coderabbit": {
        "name": "coderabbit",
        "mode": "local",
        "trigger": "completed-cluster",
        "capabilities": [
          "diff-review",
          "result-parsing"
        ],
        "execution": {
          "command": "coderabbit",
          "args": [
            "review",
            "--agent",
            "--light"
          ],
          "output": {
            "format": "jsonl",
            "parser": "coderabbit"
          },
          "configPath": ".coderabbit.yaml"
        },
        "timeoutMs": 900000,
        "primary": true,
        "failurePolicy": {
          "timeout": "fail",
          "parseFailure": "fail",
          "rateLimited": "fail",
          "allProvidersFailed": "block"
        },
        "rateLimit": {
          "requestsPerMinute": 10,
          "maxConcurrent": 1
        },
        "retry": {
          "maxRetries": 2,
          "backoffMs": 1000
        },
        "artifactPolicy": {
          "retainRawOutput": false,
          "outputDir": ".polaris/qc-artifacts"
        }
      }
    },
    "severityThresholds": {
      "block": "high",
      "repair": "medium",
      "followUp": "low"
    },
    "repairRouting": "route"
  },
  "version": "1.0",
  "providers": {
    "compactionProviders": [
      "caveman"
    ],
    "repoAnalysis": {
      "preferred": "polaris-graph"
    }
  },
  "repo": {
    "sourceRoots": [
      "."
    ]
  }
}
